#!/usr/bin/env node
/**
 * keel — sets up and maintains configuration that keel did not author.
 *
 * Scope discipline: keel owns no runtime. It does not store memories, serve an
 * API, or run a daemon. Its entire job is to make somebody else's tool correctly
 * configured for Claude Code, and to keep it that way across updates.
 *
 * That means everything here is idempotent and surgical. keel writes only keys it
 * owns (the KEEL_* env block in settings.json), preserves everything else byte for
 * byte where it can, and reports rather than repairs anything ambiguous. Config
 * files belong to the user; a setup tool that clobbers them is a bug with a nice
 * interface.
 *
 * Commands:
 *   keel status     what is wired, what is missing, what is stale
 *   keel setup      name this machine and wire the enabled adapters
 *   keel settings   recommended posture, each rule explained and linked
 *   keel doctor     verify prerequisites and configuration; exit 1 on problems
 *   keel update     pull the latest keel and any installed bridge plugins
 *   keel migrate    restore marketplaces + plugins from a config a reset moved aside
 *   keel link       put keel on your PATH, via a shim that can't go stale
 */

import { readFileSync, writeFileSync, existsSync, mkdirSync, copyFileSync, readdirSync, readlinkSync, symlinkSync, unlinkSync, renameSync, statSync, lstatSync, chmodSync } from "node:fs";
import { homedir, hostname } from "node:os";
import { join, dirname, resolve } from "node:path";
import { spawnSync } from "node:child_process";
import { createInterface } from "node:readline/promises";
import { stdin, stdout } from "node:process";

const CONFIG_DIR = process.env.CLAUDE_CONFIG_DIR?.trim() || join(homedir(), ".claude");
const SETTINGS = join(CONFIG_DIR, "settings.json");
const LOCAL_SETTINGS = join(CONFIG_DIR, "settings.local.json");

/**
 * XDG base directories, with the spec's defaults.
 *
 * keel creates nothing directly in $HOME. A tool that drops `~/.keel` and
 * `~/claude-backup-20260727-004512` into someone's home
 * directory is a tool they will eventually resent, and the resentment is
 * earned — those are the tool's files, not the user's, and they belong under
 * ~/.local where the user never has to look at them.
 *
 * Everything here is a DEFAULT. Every path is overridable, because a tidy home
 * directory is a preference and preferences belong to the person whose home it
 * is.
 */
const XDG_DATA = process.env.XDG_DATA_HOME?.trim() || join(homedir(), ".local", "share");
const XDG_STATE = process.env.XDG_STATE_HOME?.trim() || join(homedir(), ".local", "state");
const DEFAULT_NOTES_DIR = join(XDG_DATA, "keel", "notes");
const DEFAULT_BACKUP_DIR = join(XDG_STATE, "keel", "backups");

/**
 * Keys keel manages, split by whether they survive a trip to another machine.
 *
 * OWNED_KEYS mean the same thing on any machine and live in settings.json.
 * LOCAL_KEYS are absolute paths and machine identity — they differ per box by
 * definition, so they go to settings.local.json, which is gitignored by
 * convention and safe to keep out of any dotfiles repo you sync by hand.
 */
const OWNED_KEYS = ["KEEL_HINDSIGHT_URL"];
const LOCAL_KEYS = ["KEEL_MEMORY_HOME", "KEEL_DEVICE"];

const c = {
  dim: (s) => `\x1b[2m${s}\x1b[0m`,
  bold: (s) => `\x1b[1m${s}\x1b[0m`,
  green: (s) => `\x1b[32m${s}\x1b[0m`,
  yellow: (s) => `\x1b[33m${s}\x1b[0m`,
  red: (s) => `\x1b[31m${s}\x1b[0m`,
};

/**
 * Whether an adapter's bridge plugin is actually installed and enabled, via the
 * documented `claude plugin list --json` surface. An adapter can be fully
 * configured in settings.json and still unreachable — the env var is read by a
 * plugin-provided MCP server, and if that plugin isn't enabled the adapter
 * silently does nothing. Returns null for "unknown" (no claude CLI, bad
 * output); callers must not report unknown as a problem.
 */
let PLUGIN_LIST;
function pluginState(name) {
  if (PLUGIN_LIST === undefined) {
    try {
      const r = spawnSync("claude", ["plugin", "list", "--json"], { encoding: "utf-8", timeout: 15000 });
      PLUGIN_LIST = r.status === 0 ? JSON.parse(r.stdout) : null;
    } catch {
      PLUGIN_LIST = null;
    }
  }
  if (!Array.isArray(PLUGIN_LIST)) return null;
  const hit = PLUGIN_LIST.find((p) => String(p.id ?? "").split("@")[0] === name);
  return { installed: Boolean(hit), enabled: Boolean(hit?.enabled) };
}

function readJson(path) {
  if (!existsSync(path)) return {};
  try {
    return JSON.parse(readFileSync(path, "utf-8"));
  } catch (e) {
    console.error(c.red(`✖ ${path} is not valid JSON — refusing to touch it.`));
    console.error(`  ${e.message}`);
    process.exit(1);
  }
}

function readSettings() {
  return readJson(SETTINGS);
}

/**
 * The env Claude Code actually sees: settings.local.json wins over settings.json,
 * which is what makes a machine-specific override an override rather than a
 * conflict. Read through this, never through readSettings alone, or doctor will
 * report a correctly-configured machine as unconfigured.
 */
function effectiveEnv() {
  return { ...(readSettings().env ?? {}), ...(readJson(LOCAL_SETTINGS).env ?? {}) };
}

/**
 * Merge owned keys into settings.env, preserving everything else. Backs the file
 * up once per run before the first write: this is the user's config, and keel is
 * a guest in it.
 */
function writeOwnedEnv(patch) {
  const settings = readSettings();
  const before = JSON.stringify(settings);

  settings.env = { ...(settings.env ?? {}) };
  for (const [k, v] of Object.entries(patch)) {
    if (!OWNED_KEYS.includes(k)) throw new Error(`keel does not own the key ${k}`);
    if (v === null) delete settings.env[k];
    else settings.env[k] = v;
  }

  if (JSON.stringify(settings) === before) return false;

  if (existsSync(SETTINGS)) {
    const backup = `${SETTINGS}.keel-backup`;
    copyFileSync(SETTINGS, backup);
  }
  mkdirSync(dirname(SETTINGS), { recursive: true });
  writeFileSync(SETTINGS, JSON.stringify(settings, null, 2) + "\n");
  return true;
}

/**
 * The same contract as writeOwnedEnv, against settings.local.json.
 *
 * This file is the reason two machines can share a config directory without
 * fighting: absolute paths and device identity live here, it is gitignored by
 * convention, and Claude Code layers it over settings.json. Before this existed
 * `keel setup` wrote a machine's home path into the synced file and every pull
 * conflicted on that line.
 */
function writeLocalEnv(patch) {
  const settings = readJson(LOCAL_SETTINGS);
  const before = JSON.stringify(settings);

  settings.env = { ...(settings.env ?? {}) };
  for (const [k, v] of Object.entries(patch)) {
    if (!LOCAL_KEYS.includes(k)) throw new Error(`keel does not own the local key ${k}`);
    if (v === null) delete settings.env[k];
    else settings.env[k] = v;
  }

  if (JSON.stringify(settings) === before) return false;

  if (existsSync(LOCAL_SETTINGS)) copyFileSync(LOCAL_SETTINGS, `${LOCAL_SETTINGS}.keel-backup`);
  mkdirSync(dirname(LOCAL_SETTINGS), { recursive: true });
  writeFileSync(LOCAL_SETTINGS, JSON.stringify(settings, null, 2) + "\n");
  return true;
}

/**
 * Is `cmd` on PATH? Passing an args array together with shell:true concatenates
 * without escaping (Node DEP0190), so each platform gets a real argv instead.
 */
function have(cmd) {
  const safe = /^[A-Za-z0-9._-]+$/.test(cmd);
  if (!safe) return false;
  const r =
    process.platform === "win32"
      ? spawnSync("where", [cmd], { encoding: "utf-8" })
      : spawnSync("/bin/sh", ["-c", `command -v ${cmd}`], { encoding: "utf-8" });
  return (r.status ?? 1) === 0;
}

// ── what you get for free ───────────────────────────────────────────────────
// Stated explicitly because the most common setup mistake is assuming you must
// configure something. You don't. Everything here works the moment the plugin
// is installed, with no dependencies, no accounts, and no data leaving the box.
const INCLUDED = [
  ["ingest boundary", "web + MCP results marked as data, never instructions"],
  ["commit hygiene", "blocks attribution trailers you don't want in history"],
  ["activity log", "records what you asked and concluded, tagged by repo + branch"],
];

// ── adapters ────────────────────────────────────────────────────────────────
// Optional, and genuinely optional — not "optional but you'll want it".
// Each declares what it costs you, because a dependency you didn't understand
// is the thing you resent later. `egress` is called out separately from
// `prereq`: the question "does my text leave this machine" deserves its own
// line rather than being buried in a requirements list.

const ADAPTERS = {
  memory: {
    plugin: "keel-memory",
    title: "Durable notes (Basic Memory)",
    blurb: "Markdown notes on disk, searchable by Claude. No server, no account.",
    available: true,
    cost: "uv + Python 3.12 (uv provisions the interpreter for you)",
    egress: "none — local files and a local index",
    envKey: "KEEL_MEMORY_HOME",
    flag: "memory-home",
    prompt: "Where should notes live?",
    // Hidden by default: tool state does not belong as a visible directory in
    // the user's home. Anyone who wants it visible can say so at the prompt.
    defaultValue: () => DEFAULT_NOTES_DIR,
    prereq: () => ({
      ok: have("uvx"),
      what: "uvx (from uv)",
      fix: "curl -LsSf https://astral.sh/uv/install.sh | sh",
    }),
    validate: (v) => (v?.startsWith("/") || v?.startsWith("~") ? null : "must be an absolute path"),
    // Setup creates the directory, but nothing guarantees it is still there on
    // doctor day — a synced settings.json arrives on machines that never ran
    // setup, and users move directories.
    verify: (v) =>
      existsSync(v.replace(/^~/, homedir()))
        ? null
        : `notes directory does not exist: ${v}\n      fix: mkdir -p '${v}'`,
    postSetup: (v) => {
      mkdirSync(v.replace(/^~/, homedir()), { recursive: true });
      return `notes directory ready at ${v}`;
    },
  },
  reflect: {
    plugin: "keel-reflect",
    externallyWired: () => findMcpServer(/hindsight/i),
    title: "Reflection (Hindsight)",
    blurb: "Memory that revises its own conclusions over time, in the background.",
    available: false,
    reason:
      "not shipped in v0.1 — the adapter was cut rather than released untested.\n" +
      "        You almost certainly do not need it: everything keel does for weekly\n" +
      "        summaries and priorities runs in-session on your existing subscription.\n" +
      "        Reflection only matters if you want derivation while you are away.",
    cost: "a self-hosted container, plus an inference provider of your choosing",
    egress:
      "NOT zero by default — extraction calls a model. Local (Ollama/LM Studio)\n" +
      "      is the only genuinely zero-egress configuration.",
    envKey: "KEEL_HINDSIGHT_URL",
    flag: "hindsight-url",
    prompt: "Hindsight base URL?",
    defaultValue: () => "http://localhost:8888",
    prereq: () => ({ ok: false, what: "the keel-reflect adapter (not in v0.1)", fix: "see docs/MEMORY-ARCHITECTURE.md" }),
    validate: (v) => (/^https?:\/\//.test(v ?? "") ? null : "must be an http(s) URL"),
    postSetup: () => null,
  },
};

/**
 * Find an MCP server matching a pattern, and say what scope it is wired at.
 *
 * WHY THIS EXISTS
 * doctor reported "Reflection (Hindsight) — not configured" on a machine where
 * Hindsight was demonstrably working: recall and reflect had both been used
 * minutes earlier. Both statements were true at once. keel's own adapter
 * (KEEL_HINDSIGHT_URL plus the keel-reflect plugin) was cut before v0.1 and
 * never shipped, so from keel's side nothing was configured — while the
 * instance had been wired straight into Claude Code as an MCP server, which
 * keel neither manages nor looked for.
 *
 * Reporting only on the parts keel owns, and phrasing it as though it were the
 * whole picture, is how a verify command teaches you to stop believing it. keel
 * does not manage this wiring and should not pretend to; it should say that it
 * sees it and that somebody else owns it.
 *
 * SCOPE IS MOST OF THE VALUE
 * `claude mcp add` defaults to *local* scope: the server is registered for the
 * one directory the command ran in and nowhere else. Adding it from $HOME
 * therefore yields a server that is connected, healthy, passes `claude mcp
 * list` — and is invisible in every repo you actually work in, with no error
 * raised anywhere. Naming the scope is the difference between "it's wired" and
 * "it's wired somewhere you will never be standing".
 *
 * PRIVACY
 * Reads the mcpServers maps and nothing else. That file also carries an oauth
 * account, a user id and a machine id; keel has no business with any of them,
 * so only a server name and a URL host ever leave this function.
 */
function findMcpServer(pattern) {
  let cfg;
  try {
    cfg = JSON.parse(readFileSync(join(homedir(), ".claude.json"), "utf-8"));
  } catch {
    return null; // absent, unreadable, or a shape we do not recognise
  }
  const matches = (name, s) => pattern.test(name) || pattern.test(String(s?.url ?? ""));
  for (const [name, s] of Object.entries(cfg?.mcpServers ?? {})) {
    if (matches(name, s)) return { name, url: String(s?.url ?? ""), scope: "user" };
  }
  // Project scope second: a user-scope entry is the one that works everywhere,
  // so if both exist the broader one is the honest thing to report.
  for (const [dir, proj] of Object.entries(cfg?.projects ?? {})) {
    for (const [name, s] of Object.entries(proj?.mcpServers ?? {})) {
      if (matches(name, s)) return { name, url: String(s?.url ?? ""), scope: "project", dir };
    }
  }
  return null;
}

/** Host only — a bank path can name a project, and doctor output gets pasted. */
function hostOf(url) {
  try {
    return new URL(url).host;
  } catch {
    return "";
  }
}

// ── commands ────────────────────────────────────────────────────────────────

function activityDir() {
  return process.env.KEEL_ACTIVITY_DIR?.trim() || join(CONFIG_DIR, "keel", "activity");
}

/** Every activity record, newest first. Cheap: these files are small and monthly. */
const ACTIVITY_KINDS = new Set(["ask", "said", "end"]);
function readActivity() {
  const dir = activityDir();
  if (!existsSync(dir)) return [];
  const rows = [];
  for (const f of readdirSync(dir).filter((x) => x.endsWith(".jsonl"))) {
    for (const line of readFileSync(join(dir, f), "utf-8").split("\n")) {
      if (!line.trim()) continue;
      // The security guard logs into this directory too; select by kind
      // rather than assuming every .jsonl here is activity.
      try {
        const r = JSON.parse(line);
        if (ACTIVITY_KINDS.has(r.kind)) rows.push(r);
      } catch { /* skip a torn line */ }
    }
  }
  return rows.sort((a, b) => String(b.ts).localeCompare(String(a.ts)));
}

function cmdStatus() {
  const env = effectiveEnv();
  const acts = readActivity();
  console.log(`\n${c.bold("keel")}  ${c.dim(CONFIG_DIR)}`);

  // The free tier first, and unconditionally — so nobody concludes keel needs
  // configuring before it does anything.
  console.log(`\n  ${c.bold("Working now")} ${c.dim("— no setup, no dependencies, nothing leaves this machine")}`);
  for (const [name, what] of INCLUDED) {
    console.log(`    ${c.green("✔")} ${name.padEnd(20)} ${c.dim(what)}`);
  }
  console.log(
    `    ${acts.length ? c.green("✔") : c.dim("·")} ${"records captured".padEnd(20)} ` +
      c.dim(acts.length ? `${acts.length} in ${activityDir().replace(homedir(), "~")}` : "none yet — run a session"),
  );

  console.log(`\n  ${c.bold("Optional")} ${c.dim("— genuinely optional; skip all of it and keel still works")}`);
  for (const [, a] of Object.entries(ADAPTERS)) {
    const val = env[a.envKey];
    const pre = a.prereq();
    const mark = !a.available ? c.dim("—") : val ? (pre.ok ? c.green("●") : c.yellow("●")) : c.dim("○");
    const state = !a.available
      ? c.dim("not in v0.1")
      : val
        ? c.dim(val)
        : c.dim("not configured");
    console.log(`    ${mark} ${a.title.padEnd(32)} ${state}`);
    if (a.cost) console.log(`        ${c.dim(`costs:  ${a.cost}`)}`);
    if (a.egress) console.log(`        ${c.dim(`egress: ${a.egress}`)}`);
    if (!a.available && a.reason) console.log(`        ${c.dim(a.reason)}`);
    if (a.available && val && !pre.ok) console.log(`        ${c.yellow(`missing ${pre.what}`)} → ${pre.fix}`);
  }

  console.log(`\n  ${c.dim("keel log      what you've been doing")}`);
  console.log(`  ${c.dim("keel setup    wire an optional adapter")}`);
  console.log(`  ${c.dim("keel doctor   verify everything")}`);
  console.log(`  ${c.dim("keel update   pull the latest keel")}\n`);
}

/** Recent activity, grouped by day then project. Raw material for a summary. */
function cmdLog(argv) {
  const flags = parseFlags(argv);
  const days = Number(flags.days ?? 7) || 7;
  const cutoff = new Date(Date.now() - days * 86400_000).toISOString();
  const all = readActivity().filter((r) => String(r.ts) >= cutoff);
  const rows = all.filter((r) => r.kind === "ask");

  // --json is what the `week` skill consumes. Emitting the repo roster alongside
  // the records saves the skill from guessing which checkouts to run git in.
  if (flags.json) {
    const repos = {};
    for (const r of all) {
      if (!r.repo) continue;
      const e = (repos[r.repo] ??= { repo: r.repo, cwds: new Set(), branches: new Set(), prompts: 0 });
      if (r.cwd) e.cwds.add(r.cwd);
      if (r.branch) e.branches.add(r.branch);
      if (r.kind === "ask") e.prompts++;
    }
    console.log(JSON.stringify({
      since: cutoff,
      days,
      counts: { asks: rows.length, records: all.length },
      repos: Object.values(repos).map((e) => ({
        repo: e.repo,
        checkouts: [...e.cwds],
        branches: [...e.branches],
        prompts: e.prompts,
      })),
      records: all.map(({ ts, kind, repo, branch, worktree, text }) => ({
        ts, kind, repo, branch, worktree,
        text: text ? String(text).slice(0, 600) : undefined,
      })),
    }, null, 2));
    return;
  }

  if (!rows.length) {
    console.log(`\n  ${c.dim(`no activity recorded in the last ${days} day(s)`)}`);
    console.log(`  ${c.dim(`log lives at ${activityDir().replace(homedir(), "~")}`)}\n`);
    return;
  }

  console.log(`\n${c.bold(`Last ${days} days`)} ${c.dim(`— ${rows.length} prompts`)}\n`);
  const byDay = new Map();
  for (const r of rows) {
    const day = String(r.ts).slice(0, 10);
    if (!byDay.has(day)) byDay.set(day, new Map());
    const proj = r.repo ?? "(no repo)";
    const list = byDay.get(day).get(proj) ?? [];
    list.push(r);
    byDay.get(day).set(proj, list);
  }
  for (const [day, projects] of byDay) {
    console.log(`  ${c.bold(day)}`);
    for (const [proj, list] of projects) {
      const branches = [...new Set(list.map((r) => r.branch).filter(Boolean))];
      console.log(`    ${proj}${branches.length ? c.dim(`  (${branches.join(", ")})`) : ""}  ${c.dim(`${list.length}`)}`);
      for (const r of list.slice(0, 4)) console.log(`      ${c.dim("·")} ${String(r.text).slice(0, 92)}`);
      if (list.length > 4) console.log(`      ${c.dim(`… ${list.length - 4} more`)}`);
    }
    console.log();
  }
  console.log(`  ${c.dim('ask Claude "what did I do last week?" to turn this into a summary')}\n`);
}

/**
 * Flags win, then existing config, then an interactive prompt — and prompting
 * only happens on a TTY. A setup tool that can only be driven by a human cannot
 * be scripted, put in CI, or tested, which defeats the point of calling it
 * automation. Non-interactive with missing values fails loudly instead of
 * hanging on a read that will never be answered.
 */
function parseFlags(argv) {
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith("--")) continue;
    const [k, inline] = a.slice(2).split("=");
    flags[k] = inline ?? (argv[i + 1] && !argv[i + 1].startsWith("--") ? argv[++i] : "true");
  }
  return flags;
}

async function cmdSetup(argv) {
  const flags = parseFlags(argv);
  const interactive = stdin.isTTY && !flags["non-interactive"];
  const rl = interactive ? createInterface({ input: stdin, output: stdout }) : null;
  let missing = 0;

  try {
    console.log(`\n${c.bold("keel setup")} — configures adapters. Nothing is installed silently.\n`);

    /**
     * Device name first, because the activity log is already writing without it.
     *
     * Log files are scoped by month and device. The fallback is hostname(), which
     * on WSL is the Windows machine name — so two boxes can collide, and the
     * collision is invisible until you compare logs and find a month of work
     * attributed to the wrong machine. Naming it explicitly costs one prompt.
     */
    {
      const current = effectiveEnv().KEEL_DEVICE;
      const fallback = hostname().toLowerCase().slice(0, 32);
      if (current) {
        console.log(`${c.bold("This machine")}\n  ${c.green("✔")} device "${current}"\n`);
      } else if (flags["device"]) {
        writeLocalEnv({ KEEL_DEVICE: flags["device"] });
        console.log(`${c.bold("This machine")}\n  ${c.green("✔")} device "${flags["device"]}"\n`);
      } else if (interactive) {
        console.log(`${c.bold("This machine")}`);
        console.log(`  ${c.dim("Names this machine in the activity log. Defaults to the hostname,")}`);
        console.log(`  ${c.dim("which on WSL is the Windows machine name and can collide.")}`);
        const name = (await rl.question(`  Name for this machine? ${c.dim(`[${fallback}]`)} `)).trim() || fallback;
        writeLocalEnv({ KEEL_DEVICE: name });
        console.log(`  ${c.green("✔")} device "${name}" ${c.dim("→ settings.local.json")}\n`);
      } else {
        console.log(`${c.bold("This machine")}`);
        console.log(`  ${c.dim(`device not set — falling back to hostname "${fallback}"`)}`);
        console.log(`  ${c.dim("set it with: keel setup --device <name>")}\n`);
      }
    }

    for (const [name, a] of Object.entries(ADAPTERS)) {
      const env = effectiveEnv();
      const current = env[a.envKey];
      const flagValue = flags[a.flag];
      const skipped = flags["skip"]?.split(",").includes(name);

      console.log(`${c.bold(a.title)}\n  ${c.dim(a.blurb)}`);

      if (skipped) {
        console.log(c.dim("  skipped (--skip)\n"));
        continue;
      }

      // An adapter that doesn't exist yet cannot be "missing" — there is nothing
      // the user could do about it. Counting it made `keel setup --memory-home X`
      // exit 1 on a run that did exactly what was asked, which any `&&` chain or
      // CI step reads as failure.
      if (!a.available) {
        console.log(`  ${c.dim(a.reason ?? "not available in this version")}\n`);
        continue;
      }

      const pre = a.prereq();
      if (!pre.ok) {
        console.log(`  ${c.yellow(`⚠ ${pre.what} not found`)} — install it, then re-run:\n     ${pre.fix}`);
      }

      let value = flagValue ?? current;

      if (!value) {
        if (!interactive) {
          console.log(`  ${c.dim(`not configured — pass --${a.flag} <value> to wire it`)}\n`);
          missing++;
          continue;
        }
        const want = (await rl.question(`  Configure it? [y/N] `)).trim().toLowerCase();
        if (want !== "y" && want !== "yes") {
          console.log(c.dim("  skipped\n"));
          continue;
        }
        const def = a.defaultValue();
        value = (await rl.question(`  ${a.prompt} ${c.dim(`[${def}]`)} `)).trim() || def;
      }

      const bad = a.validate(value);
      if (bad) {
        console.log(`  ${c.red(`✖ ${bad}`)} — not written\n`);
        missing++;
        continue;
      }

      const changed = (LOCAL_KEYS.includes(a.envKey) ? writeLocalEnv : writeOwnedEnv)({ [a.envKey]: value });
      const note = a.postSetup(value);
      console.log(`  ${c.green("✔")} ${changed ? "written to settings.json" : "already set"}${note ? ` · ${note}` : ""}`);
      // The hint has to match reality: `enable` only works on a plugin that is
      // already installed, and a fresh machine has not installed it yet.
      const ps = pluginState(a.plugin);
      if (ps?.enabled) {
        console.log(`  ${c.dim(`${a.plugin} plugin already enabled`)}\n`);
      } else if (ps?.installed) {
        console.log(`  ${c.dim(`enable the bridge: claude plugin enable ${a.plugin}@keel`)}\n`);
      } else {
        console.log(`  ${c.dim(`install the bridge: claude plugin install ${a.plugin}@keel`)}\n`);
      }
    }

    console.log(`Done. ${c.dim("Restart Claude Code (or /reload-plugins) to pick up MCP changes.")}\n`);
  } finally {
    rl?.close();
  }
  return missing;
}

function cmdDoctor() {
  const env = effectiveEnv();
  let problems = 0;
  console.log(`\n${c.bold("keel doctor")}\n`);

  if (!existsSync(SETTINGS)) {
    console.log(`  ${c.yellow("○")} no settings.json at ${SETTINGS} — run \`keel setup\``);
    problems++;
  }

  // The activity log is the reason most people run keel, and it is the one part
  // that fails silently by design: the hook swallows write errors so a broken
  // directory can never break a session. That trade is right for the hook and
  // wrong for doctor, whose entire job is to be noisy. A dead symlink or a
  // read-only mount otherwise costs weeks of capture with nothing to notice.
  {
    const dir = activityDir();
    const probe = join(dir, ".keel-write-probe");
    try {
      mkdirSync(dir, { recursive: true });
      writeFileSync(probe, "");
      unlinkSync(probe);
      console.log(`  ${c.green("✔")} activity log writable ${c.dim(dir.replace(homedir(), "~"))}`);
    } catch (e) {
      console.log(`  ${c.red("✖")} activity log is NOT writable — nothing is being recorded`);
      console.log(`      path: ${dir}`);
      console.log(`      error: ${String(e?.code ?? e?.message ?? e)}`);
      console.log(`      fix: check permissions; if ${join(CONFIG_DIR, "keel").replace(homedir(), "~")} is a symlink, check its target exists`);
      problems++;
    }
  }

  /**
   * Which keel is actually running, and what the PATH entry resolves to.
   *
   * doctor reported "all good" on a machine whose CLI was fourteen commits
   * behind. It checked the activity log, the adapters and the plugin roster —
   * everything except itself. The PATH symlink pointed into the plugin cache at
   * a version directory the update had left behind, so it resolved cleanly and
   * ran old code, and the one command whose entire job is to be noisy had
   * nothing to say about it.
   *
   * Reported here rather than repaired: `keel update` migrates the entry, and a
   * verify command that quietly rewrites things is a verify command you stop
   * being able to trust. Running from outside the plugin cache is a dev checkout
   * or somebody's own copy — not stale, just not ours to have an opinion about.
   */
  {
    const installed = installedBinary();
    const running = process.argv[1] ? resolve(process.argv[1]) : null;
    const link = join(homedir(), ".local", "bin", "keel");
    let stale = 0;

    if (!installed) {
      console.log(`  ${c.dim("○")} no plugin install record — can't tell which copy is current`);
    } else {
      const want = resolve(installed);

      const fromCache = Boolean(running?.startsWith(PLUGIN_CACHE));
      if (fromCache && running !== want) {
        console.log(`  ${c.red("✖")} you are running a stale copy of keel`);
        console.log(`      running:   ${running.replace(homedir(), "~")}`);
        console.log(`      installed: ${want.replace(homedir(), "~")}`);
        console.log(`      fix: keel update ${c.dim("(migrates the PATH entry so this cannot recur)")}`);
        stale++;
      }

      let st = null;
      try {
        st = lstatSync(link);
      } catch { /* not opted in */ }

      if (st?.isSymbolicLink()) {
        const target = resolve(dirname(link), readlinkSync(link));
        if (!existsSync(target)) {
          console.log(`  ${c.red("✖")} ${link.replace(homedir(), "~")} is dangling ${c.dim(`-> ${target}`)}`);
          console.log(`      fix: keel link`);
          stale++;
        } else if (target.startsWith(PLUGIN_CACHE) && target !== want) {
          console.log(`  ${c.red("✖")} ${link.replace(homedir(), "~")} points at a stale copy ${c.dim("— it resolves, which is why nothing else noticed")}`);
          console.log(`      points at: ${target.replace(homedir(), "~")}`);
          console.log(`      installed: ${want.replace(homedir(), "~")}`);
          console.log(`      fix: keel update ${c.dim("(replaces the versioned link with a shim)")}`);
          stale++;
        }
      }

      if (stale) {
        // already reported
      } else if (fromCache) {
        const sha = installedSha("keel");
        console.log(`  ${c.green("✔")} running the installed keel${sha ? ` ${c.dim(sha.slice(0, 7))}` : ""}`);
      } else {
        // A checkout, or somebody's own copy. Not stale — just not something
        // keel has any business calling wrong.
        console.log(`  ${c.dim("○")} running from outside the plugin cache ${c.dim(running ? running.replace(homedir(), "~") : "")}`);
      }
      problems += stale;
    }
  }

  for (const [, a] of Object.entries(ADAPTERS)) {
    const val = env[a.envKey];
    if (!val) {
      // keel's own adapter is unset — but the backend may still be wired
      // directly into Claude Code, in which case "not configured" is a lie by
      // omission. See findMcpServer.
      const ext = a.externallyWired?.();
      if (ext?.scope === "user") {
        const where = hostOf(ext.url);
        console.log(`  ${c.dim("○")} ${a.title} — wired as an MCP server, outside keel${where ? ` ${c.dim(where)}` : ""}`);
      } else if (ext) {
        // Not counted as a problem: scoping a server to one project can be
        // deliberate. But it is far more often `claude mcp add` run from the
        // wrong directory, and the failure is silent everywhere else.
        console.log(`  ${c.yellow("!")} ${a.title} — wired as an MCP server, but only for one project`);
        console.log(`      project: ${String(ext.dir ?? "").replace(homedir(), "~")}`);
        console.log(`      ${c.dim("invisible in every other directory; deliberate scoping is fine")}`);
        console.log(`      fix: claude mcp remove ${ext.name} && claude mcp add --scope user ...`);
      } else {
        console.log(`  ${c.dim("○")} ${a.title} — not configured ${c.dim("(fine if unused)")}`);
      }
      continue;
    }
    const bad = a.validate(val);
    const pre = a.prereq();
    if (bad) {
      console.log(`  ${c.red("✖")} ${a.title} — ${bad}: ${val}`);
      problems++;
      continue;
    }
    if (!pre.ok) {
      console.log(`  ${c.red("✖")} ${a.title} — missing ${pre.what}\n      fix: ${pre.fix}`);
      problems++;
      continue;
    }
    const drift = a.verify?.(val);
    if (drift) {
      console.log(`  ${c.red("✖")} ${a.title} — ${drift}`);
      problems++;
      continue;
    }
    // Configured and prerequisites present — but the env var only matters if
    // the bridge plugin that reads it is installed and enabled.
    const ps = a.plugin ? pluginState(a.plugin) : null;
    if (ps && !ps.installed) {
      console.log(`  ${c.red("✖")} ${a.title} — configured, but the ${a.plugin} plugin is not installed\n      fix: claude plugin install ${a.plugin}@keel`);
      problems++;
    } else if (ps && !ps.enabled) {
      console.log(`  ${c.red("✖")} ${a.title} — configured, but the ${a.plugin} plugin is disabled\n      fix: claude plugin enable ${a.plugin}@keel`);
      problems++;
    } else {
      const note = ps ? "" : c.dim("  (plugin state unknown — claude CLI unreachable)");
      console.log(`  ${c.green("✔")} ${a.title} ${c.dim(val)}${note}`);
    }
  }

  console.log(problems ? `\n${c.red(`${problems} problem(s)`)}\n` : `\n${c.green("all good")}\n`);
  process.exit(problems ? 1 : 0);
}

/**
 * The update slice of install.sh, without the ceremony — no backup, no reset,
 * no adapter prompts. Refresh the marketplace, update keel, update whichever
 * bridge plugins are actually installed, and repair the PATH symlink if a
 * version bump moved the cache directory out from under it.
 */
function cmdUpdate() {
  const claude = (args) => {
    const r = spawnSync("claude", args, { encoding: "utf-8", timeout: 120000 });
    return { ok: r.status === 0, out: (r.stdout || r.stderr || "").trim() };
  };
  console.log(`\n${c.bold("keel update")}\n`);
  if (spawnSync("claude", ["--version"], { encoding: "utf-8" }).status !== 0) {
    console.log(`  ${c.red("✖")} claude CLI not reachable — nothing updated\n`);
    process.exit(1);
  }
  let problems = 0;
  const step = (label, args) => {
    const r = claude(args);
    console.log(`  ${r.ok ? c.green("✔") : c.red("✖")} ${label}${r.ok ? "" : `\n      ${c.dim(r.out.split("\n")[0] ?? "")}`}`);
    if (!r.ok) problems++;
    return r.ok;
  };
  step("marketplace refreshed", ["plugin", "marketplace", "update"]);

  /**
   * Move the checkout ourselves, because `marketplace update` may not.
   *
   * Observed in the field: `marketplace update` reports success and `git pull`
   * in that checkout then prints "Already up to date" while origin/main has
   * moved — the checkout's HEAD isn't tracking the branch it fetched. The result
   * is a perfectly successful update to a stale target: every downstream check,
   * including the sha comparison below, agrees you are current because both
   * sides are equally old.
   *
   * Fast-forward only, and never on a dirty tree. This is Claude Code's
   * directory; nudging a ref forward is the most keel should do to it, and
   * discarding somebody's local edits is not on the table.
   */
  const mp = join(CONFIG_DIR, "plugins", "marketplaces", "keel");
  if (existsSync(join(mp, ".git"))) {
    const git = (...a) => spawnSync("git", ["-C", mp, ...a], { encoding: "utf-8", timeout: 60000 });
    const dirty = (git("status", "--porcelain").stdout ?? "").trim();
    if (dirty) {
      console.log(`  ${c.yellow("!")} marketplace checkout has local changes — leaving it alone`);
    } else {
      git("fetch", "--quiet", "origin");
      const before = (git("rev-parse", "HEAD").stdout ?? "").trim();
      const ff = git("merge", "--ff-only", "origin/HEAD");
      const after = (git("rev-parse", "HEAD").stdout ?? "").trim();
      if (before && after && before !== after) {
        console.log(`  ${c.green("✔")} marketplace checkout advanced ${c.dim(`${before.slice(0, 7)} → ${after.slice(0, 7)}`)}`);
      } else if (ff.status !== 0 && /diverge|not possible|refusing/i.test(ff.stderr ?? "")) {
        console.log(`  ${c.yellow("!")} marketplace checkout has diverged from origin — reset it by hand`);
      }
    }
  }
  step("keel updated", ["plugin", "update", "keel@keel"]);

  /**
   * `claude plugin update` decides staleness from the version string in
   * plugin.json. keel's rarely moves, so every commit since the last bump is
   * invisible to it — it reports "already at the latest version" and does
   * nothing. An update channel that reports success while doing nothing is
   * worse than no update channel: it means a security fix silently never
   * reaches the machines that need it.
   *
   * So don't trust the report. Compare the commit Claude Code recorded at
   * install against the commit the marketplace checkout actually holds, and
   * reinstall when they diverge. Both values come from documented surfaces:
   * installed_plugins.json and the checkout's own git HEAD.
   */
  const wantSha = marketplaceSha();
  const haveSha = installedSha("keel");
  if (wantSha && haveSha && wantSha !== haveSha) {
    console.log(`  ${c.yellow("!")} version-pinned update was a no-op ${c.dim(`(installed ${haveSha.slice(0, 7)}, marketplace ${wantSha.slice(0, 7)})`)}`);

    /**
     * Reinstalling resets a plugin to its manifest default, which is not the
     * same as the state it was in. Observed on a real machine via
     * scripts/bootstrap.sh, which does the same uninstall+install: it silently
     * disabled keel-memory, because adapters ship `defaultEnabled: false` on
     * purpose. The repair broke the thing it was repairing, and the only
     * symptom was an adapter that quietly stopped working.
     *
     * keel's own manifest has no defaultEnabled, so today it survives — but a
     * repair step that depends on a manifest field staying absent is a trap
     * set for later. Capture enablement, restore it.
     */
    const wasEnabled = pluginState("keel")?.enabled;
    const reinstalled =
      claude(["plugin", "uninstall", "keel@keel"]).ok && claude(["plugin", "install", "keel@keel"]).ok;

    PLUGIN_LIST = undefined; // the roster changed under us
    if (reinstalled && wasEnabled && pluginState("keel")?.enabled === false) {
      claude(["plugin", "enable", "keel@keel"]);
      PLUGIN_LIST = undefined;
      console.log(`  ${c.green("✔")} re-enabled ${c.dim("(reinstall had reset it to the manifest default)")}`);
    }

    if (reinstalled && installedSha("keel") === wantSha) {
      console.log(`  ${c.green("✔")} reinstalled at ${wantSha.slice(0, 7)}`);
    } else {
      console.log(`  ${c.red("✖")} could not reinstall — run it by hand:`);
      console.log(`      ${c.dim("claude plugin uninstall keel@keel && claude plugin install keel@keel")}`);
      problems++;
    }
  }
  PLUGIN_LIST = undefined; // marketplace refresh may have changed the roster
  for (const extra of ["keel-memory", "keel-reflect"]) {
    const ps = pluginState(extra);
    if (ps?.installed) step(`${extra} updated`, ["plugin", "update", `${extra}@keel`]);
  }

  /**
   * Migrate the PATH entry off the versioned symlink, once.
   *
   * The old scheme pointed ~/.local/bin/keel at …/keel/<version>/bin/keel and
   * repaired it here on mismatch. That repair worked, but it could only ever run
   * if the link was already correct enough to reach this code — and the whole
   * failure mode is the link being wrong. A machine stayed two weeks behind with
   * every check on it reporting success, precisely because the fix was sitting
   * in a binary the stale link never invoked.
   *
   * So stop repairing and remove the failure instead: a shim that resolves
   * installPath at run time can't go stale, and doesn't need updating to keep
   * not going stale. installShim only ever replaces the old cache symlink or a
   * shim keel wrote itself.
   *
   * Only touches an entry that already exists — putting keel on your PATH stays
   * opt-in, and an update is not the moment to opt you in.
   */
  const link = join(homedir(), ".local", "bin", "keel");
  let present = false;
  try {
    lstatSync(link);
    present = true;
  } catch { /* nothing opted in, nothing to migrate */ }

  if (present) {
    const result = installShim(link);
    if (result === "created" || result === "replaced") {
      console.log(`  ${c.green("✔")} PATH entry now resolves the installed copy at run time ${c.dim(link.replace(homedir(), "~"))}`);
    }
  }

  console.log(problems
    ? `\n${c.red(`${problems} problem(s)`)} — install.sh remains the full-ceremony fallback\n`
    : `\n${c.green("up to date")} ${c.dim("— new sessions pick this up; running sessions keep their startup state")}\n`);
  process.exit(problems ? 1 : 0);
}

/**
 * The commit Claude Code recorded when it installed a keel plugin, per
 * installed_plugins.json. Null when unknown — callers must treat that as
 * "can't tell" rather than "stale".
 */
function installedSha(name) {
  try {
    const db = readJson(join(CONFIG_DIR, "plugins", "installed_plugins.json"));
    return db.plugins?.[`${name}@keel`]?.[0]?.gitCommitSha ?? null;
  } catch {
    return null;
  }
}

/** The commit the local marketplace checkout is actually at. Null when unknown. */
function marketplaceSha() {
  const dir = join(CONFIG_DIR, "plugins", "marketplaces", "keel");
  if (!existsSync(join(dir, ".git"))) return null;
  const r = spawnSync("git", ["-C", dir, "rev-parse", "HEAD"], { encoding: "utf-8", timeout: 15000 });
  return r.status === 0 ? r.stdout.trim() : null;
}

// ── the PATH entry ──────────────────────────────────────────────────────────

const PLUGIN_CACHE = join(CONFIG_DIR, "plugins", "cache", "keel");
const SHIM_MARKER = "keel-path-shim v1";

/**
 * The binary Claude Code says it installed. Null when the record is missing or
 * unreadable, which callers must treat as "can't tell" rather than "stale".
 */
function installedBinary() {
  const db = readJson(join(CONFIG_DIR, "plugins", "installed_plugins.json"));
  const p = db.plugins?.["keel@keel"]?.[0]?.installPath;
  return p ? join(p, "bin", "keel") : null;
}

/**
 * The shim that goes on your PATH, and why it is not a symlink.
 *
 * A symlink has to name a version — …/plugins/cache/keel/keel/<version>/bin/keel
 * — and an update leaves the old version directory in place. So the link goes on
 * resolving perfectly well, to code that is weeks old, with no symptom at all.
 * That is not a bug in the link; it is a link being asked to record something
 * that changes underneath it.
 *
 * The shim resolves installPath on every run instead. There is no versioned path
 * left to go stale, and — this is the part that matters — the fix stops needing
 * to live inside a binary you can only reach if the PATH entry is already
 * correct. That circularity is how a machine stayed two weeks behind while every
 * check on it reported success.
 */
function shimText() {
  return `#!/bin/sh
# ${SHIM_MARKER} — resolves the installed keel at run time.
#
# Deliberately not a symlink: a symlink names a version, an update leaves the old
# version directory in place, and the link then resolves cleanly to stale code.
# installed_plugins.json is Claude Code's own record of what it installed, so
# reading it on every run means there is no versioned path left to go stale.
#
# keel wrote this file and will keep it current. Replace it with your own and
# keel leaves it alone from then on.

CFG="\${CLAUDE_CONFIG_DIR:-\$HOME/.claude}"
DB="\$CFG/plugins/installed_plugins.json"

if [ ! -r "\$DB" ]; then
  echo "keel: no plugin install record at \$DB" >&2
  echo "  fix: claude plugin install keel@keel" >&2
  exit 127
fi

TARGET=\$(node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const p=JSON.parse(s).plugins["keel@keel"][0].installPath;if(p)process.stdout.write(p+"/bin/keel")}catch(e){}})' < "\$DB" 2>/dev/null)

if [ -z "\$TARGET" ] || [ ! -x "\$TARGET" ]; then
  echo "keel: could not resolve an installed copy from \$DB" >&2
  echo "  (node is required to read it)" >&2
  echo "  fix: claude plugin install keel@keel" >&2
  exit 127
fi

exec "\$TARGET" "\$@"
`;
}

/** Did keel write this file? Never true of a binary somebody put there themselves. */
function isKeelShim(path) {
  try {
    return readFileSync(path, "utf-8").includes(SHIM_MARKER);
  } catch {
    return false;
  }
}

/**
 * Install or refresh the PATH shim, and never touch anything that isn't keel's.
 *
 * Replaceable: nothing there, a shim keel wrote, or a symlink into the plugin
 * cache (the old scheme, which is what we are migrating away from). Anything
 * else — a real binary, a link pointing somewhere else entirely — is somebody's
 * own decision and gets left exactly as it is.
 *
 * Returns "created" | "replaced" | "current", or null when it declined.
 */
function installShim(link) {
  let st = null;
  try {
    st = lstatSync(link);
  } catch { /* nothing there yet */ }

  if (st?.isSymbolicLink()) {
    const target = resolve(dirname(link), readlinkSync(link));
    if (!target.startsWith(PLUGIN_CACHE)) return null;
  } else if (st && !isKeelShim(link)) {
    return null;
  }

  const want = shimText();
  if (st && !st.isSymbolicLink()) {
    try {
      if (readFileSync(link, "utf-8") === want) return "current";
    } catch { /* unreadable — rewrite it */ }
  }

  mkdirSync(dirname(link), { recursive: true });
  if (st) unlinkSync(link);
  writeFileSync(link, want);
  chmodSync(link, 0o755);
  return st ? "replaced" : "created";
}

/**
 * `keel link` — put keel on your PATH, or bring an existing entry up to date.
 * Opt-in by design: Claude's Bash tool finds the plugin binary on its own, so
 * this exists for people who'd rather type `keel` themselves.
 */
function cmdLink(args) {
  const i = args.indexOf("--dir");
  const dir = i >= 0 && args[i + 1] ? args[i + 1] : join(homedir(), ".local", "bin");
  const link = join(dir, "keel");
  const pretty = link.replace(homedir(), "~");

  const result = installShim(link);
  if (result === null) {
    console.log(`  ${c.yellow("!")} ${pretty} exists and isn't keel's — leaving it alone`);
    return 1;
  }
  console.log(
    result === "current"
      ? `  ${c.green("✔")} ${pretty} is current`
      : `  ${c.green("✔")} ${pretty} ${result} ${c.dim("— resolves the installed copy at run time")}`,
  );

  if (!installedBinary()) {
    console.log(`      ${c.yellow("!")} no plugin install record yet — the shim will resolve once keel is installed`);
  }
  const path = (process.env.PATH ?? "").split(":");
  if (!path.includes(dir)) {
    console.log(`      ${c.dim(`${dir} isn't on your PATH — add it: export PATH="${dir}:$PATH"`)}`);
  }
  return 0;
}

/**
 * Settings keel can advise on but does not own.
 *
 * Everything else in this file writes only KEEL_* keys. `permissions` is not
 * keel's — it is the user's security posture, and a tool that silently edits it
 * has overstepped. So this table is advice, not configuration: each rule states
 * what it would change, why, and where the behaviour is documented, and nothing
 * is written without a yes.
 *
 * Two hard constraints follow from not owning the key:
 *   - only ever APPEND to a permissions array, never remove or reorder
 *   - show the exact strings before writing them
 *
 * `why` is written to be read at 1am by someone deciding whether to accept a
 * rule they'll live with for a year. Two or three sentences, including the
 * limitation — a rule whose weaknesses you hid is worse than no rule, because
 * it buys trust it hasn't earned.
 */
const SETTINGS_RULES = [
  {
    id: "secret-files",
    title: "Deny reads of credential files",
    docs: "https://code.claude.com/docs/en/settings#permissions",
    why: [
      "keel's guard deliberately does NOT block reading these — its path rules ask before a",
      "write and let reads through, because a read is usually what you meant. That leaves the",
      "exfiltration case: a poisoned page or ticket persuading the agent to read a key and send",
      "it somewhere. These rules close that, and they close it in a layer keel cannot weaken —",
      "native rules are evaluated before any hook and are unaffected by KEEL_GUARD_OFF.",
    ],
    key: ["permissions", "deny"],
    values: ["Read(./.env)", "Read(./.env.*)", "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.gnupg/**)"],
  },
  {
    id: "catastrophic-bash",
    title: "Deny the catastrophic shell forms",
    docs: "https://code.claude.com/docs/en/settings#permissions",
    why: [
      "A second layer under keel's guard, not a replacement for it. Native rules are glob-only,",
      "so they cannot see through flag reordering or an `sh -c` wrapper the way the guard's regex",
      "does — but they run earlier and are not disabled by KEEL_GUARD_OFF. Defense in depth: the",
      "coarse net catches the obvious shapes even when the hook is off or broken.",
    ],
    key: ["permissions", "deny"],
    values: ["Bash(rm -rf /*)", "Bash(mkfs*)", "Bash(dd if=* of=/dev/*)", "Bash(wipefs*)"],
  },
  {
    id: "destructive-git",
    title: "Ask before history-rewriting git",
    docs: "https://code.claude.com/docs/en/settings#permissions",
    why: [
      "Recoverable but expensive, and exactly the shape you want a pause on rather than a block —",
      "sometimes a force-push is genuinely what you meant. `ask` prompts; it does not refuse.",
      "keel's own guard already asks on force-push; these add the reset and clean forms, and",
      "cover the case where the hook is disabled.",
    ],
    key: ["permissions", "ask"],
    values: ["Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard*)", "Bash(git clean -*f*)"],
  },
];

/**
 * `keel settings` — review the posture keel recommends but will not assume.
 *
 * Reports every rule with its rationale and a docs link, shows the exact strings
 * it would add, and applies only what is accepted. `--list` explains without
 * touching anything, which is the mode to use when deciding rather than doing.
 */
async function cmdSettings(argv) {
  const listOnly = argv.includes("--list");
  const assumeYes = argv.includes("--yes");
  const rl = listOnly || assumeYes || !stdin.isTTY ? null : createInterface({ input: stdin, output: stdout });

  try {
    console.log(`\n${c.bold("keel settings")} — recommended posture, with reasons\n`);
    const settings = readSettings();
    let applied = 0;
    let pending = 0;

    for (const rule of SETTINGS_RULES) {
      const [top, sub] = rule.key;
      const current = settings[top]?.[sub] ?? [];
      const missing = rule.values.filter((v) => !current.includes(v));

      const mark = missing.length === 0 ? c.green("✔") : c.yellow("○");
      console.log(`  ${mark} ${c.bold(rule.title)} ${c.dim(`[${rule.id}]`)}`);
      for (const line of rule.why) console.log(`      ${c.dim(line)}`);
      console.log(`      ${c.dim("docs: " + rule.docs)}`);

      if (missing.length === 0) {
        console.log(`      ${c.dim(`already set (${rule.values.length} rules in ${top}.${sub})`)}\n`);
        continue;
      }

      console.log(`      ${c.bold(`would add to ${top}.${sub}:`)}`);
      for (const v of missing) console.log(`        + ${v}`);
      pending++;

      if (listOnly) {
        console.log("");
        continue;
      }

      const want = assumeYes || (rl && (await ask1(rl, `      Apply? ${c.dim("[y/N]")} `)));
      if (want !== true && !String(want ?? "").trim().toLowerCase().startsWith("y")) {
        console.log(`      ${c.dim("skipped")}\n`);
        continue;
      }

      // Append only. This is the user's key; keel adds to it and never rewrites it.
      settings[top] = { ...(settings[top] ?? {}) };
      settings[top][sub] = [...current, ...missing];
      applied++;
      console.log(`      ${c.green("✔")} added ${missing.length}\n`);
    }

    if (applied > 0) {
      if (existsSync(SETTINGS)) copyFileSync(SETTINGS, `${SETTINGS}.keel-backup`);
      mkdirSync(dirname(SETTINGS), { recursive: true });
      writeFileSync(SETTINGS, JSON.stringify(settings, null, 2) + "\n");
      console.log(`${c.bold("Written.")} ${c.dim(SETTINGS)}`);
      console.log(`  ${c.dim(`previous version saved to ${SETTINGS}.keel-backup`)}`);
      console.log(`  ${c.dim("restart Claude Code to pick up permission changes")}\n`);
    } else if (listOnly && pending > 0) {
      console.log(`${c.dim(`${pending} rule group(s) not applied — run 'keel settings' to review interactively`)}\n`);
    } else if (pending === 0) {
      console.log(`${c.green("all recommended rules are in place")}\n`);
    } else {
      console.log(`${c.dim("nothing changed")}\n`);
    }
    return 0;
  } finally {
    rl?.close();
  }
}

/**
 * Like readJson, but tolerant. readJson exits(1) on malformed input, which is
 * right for keel's own files and wrong here: migrate reads a config that some
 * other tool wrote and that the user may have hand-edited years ago. One bad
 * file there should cost you that file's contents, not the whole command.
 */
function readJsonSoft(path) {
  if (!existsSync(path)) return {};
  try {
    return JSON.parse(readFileSync(path, "utf-8"));
  } catch {
    console.log(`  ${c.yellow("!")} ${path} is not valid JSON — skipping it`);
    return {};
  }
}

/** Every directory a reset could have left an old config in, newest first. */
function findPreviousConfigs() {
  const found = [];
  const dirs = [
    [join(XDG_STATE, "keel"), (n) => n.startsWith("previous-config-")],
    // docs/FRESH-START.md's by-hand route parks it beside the config dir instead.
    [dirname(CONFIG_DIR), (n) => n.startsWith(`${CONFIG_DIR.split("/").pop()}.old-`)],
  ];
  for (const [dir, match] of dirs) {
    if (!existsSync(dir)) continue;
    try {
      for (const n of readdirSync(dir)) if (match(n)) found.push(join(dir, n));
    } catch {
      /* unreadable dir is not an error — it just holds no candidates */
    }
  }
  // Names end in a sortable timestamp, so lexical descending is newest first.
  return found.sort().reverse();
}

/**
 * What a previous config had. Two sources per question, because Claude Code
 * records each in two places and they can disagree:
 *
 *   marketplaces — the registry (plugins/known_marketplaces.json) is what was
 *     actually cloned; settings.extraKnownMarketplaces is what was *declared*.
 *     A marketplace added but never fetched exists only in the second.
 *   plugins — installed_plugins.json is what was installed and at what scope;
 *     settings.enabledPlugins is what was switched on. A plugin can be installed
 *     and deliberately disabled, and restoring that as enabled would change how
 *     the machine behaves. Both are kept so the restore can be faithful.
 */
function readInventory(src) {
  const settings = readJsonSoft(join(src, "settings.json"));
  const declared = settings.extraKnownMarketplaces ?? {};
  const registry = readJsonSoft(join(src, "plugins", "known_marketplaces.json"));
  const enabled = settings.enabledPlugins ?? {};
  const installed = readJsonSoft(join(src, "plugins", "installed_plugins.json")).plugins ?? {};

  const marketplaces = [];
  for (const [name, e] of Object.entries({ ...declared, ...registry })) {
    const s = e?.source ?? {};
    // `claude plugin marketplace add` takes owner/repo, a URL, or a path. It does
    // NOT take installLocation: that pointed inside the config dir the reset
    // moved, so it names a directory that is no longer there.
    const spec = s.repo || s.url || s.path || null;
    marketplaces.push({ name, spec, kind: s.source ?? "unknown" });
  }

  const plugins = [];
  const add = (id, scope) => {
    if (plugins.some((p) => p.id === id)) return;
    plugins.push({ id, market: id.split("@")[1] ?? null, scope, enabled: enabled[id] !== false });
  };
  for (const [id, recs] of Object.entries(installed)) add(id, (Array.isArray(recs) ? recs[0]?.scope : null) ?? "user");
  for (const id of Object.keys(enabled)) add(id, "user");

  return { marketplaces, plugins };
}

const OFFICIAL_MARKETPLACE = "claude-plugins-official";

/**
 * The one thing migrate repairs rather than restores.
 *
 * Claude Code auto-installs the official marketplace into a config that has
 * never had it, and records that it did. The guard it consults on every start is
 * that record, not the marketplace:
 *
 *   if (!attempted)  install it;
 *   if (installed)   never again;
 *
 * A config that lost the marketplace while keeping the record therefore can
 * never get one back. No vanilla install can be in that state, and nobody chose
 * it — which is why this is offered even when there is no previous config left
 * to migrate from, and why it is worth offering to a machine that already ran
 * the old reset months ago.
 *
 * Returns null when there is nothing to repair, so the caller can treat a
 * healthy machine and an unfixable one the same way: say nothing.
 */
function officialFlagRepair(have) {
  // Present: the flag is moot, and Claude Code will re-set it on the next start.
  if (have.marketplaces.has(OFFICIAL_MARKETPLACE)) return null;
  // Whichever file exists is the one Claude Code is reading.
  const file = [join(CONFIG_DIR, ".claude.json"), join(homedir(), ".claude.json")].find(existsSync);
  if (!file) return null;
  const d = readJsonSoft(file);
  // Only the "already installed" branch suppresses retries forever. A failed
  // attempt carries its own backoff and will come back on its own.
  if (d.officialMarketplaceAutoInstalled !== true) return null;
  // Blocked by env var or enterprise policy is a decision, not damage: clearing
  // the flag would only have it re-blocked on the next start.
  if (d.officialMarketplaceAutoInstallFailReason === "policy_blocked") return null;
  const keys = Object.keys(d).filter((k) => k.startsWith("officialMarketplaceAutoInstall"));
  return keys.length ? { file, keys } : null;
}

/** Same write discipline as install.sh: mode preserved, temp file, rename. */
function applyFlagRepair(rep, dry) {
  if (dry) {
    console.log(`    ${c.dim(`would clear ${rep.keys.join(", ")} in ${rep.file}`)}`);
    return true;
  }
  try {
    const d = JSON.parse(readFileSync(rep.file, "utf-8"));
    for (const k of rep.keys) delete d[k];
    const mode = statSync(rep.file).mode & 0o777;
    const tmp = `${rep.file}.keel-tmp`;
    writeFileSync(tmp, JSON.stringify(d, null, 2), { mode });
    renameSync(tmp, rep.file);
    return true;
  } catch {
    return false;
  }
}

/** What this machine already has, so a re-run proposes only what is missing. */
function currentState() {
  const settings = readJsonSoft(SETTINGS);
  return {
    marketplaces: new Set([
      ...Object.keys(readJsonSoft(join(CONFIG_DIR, "plugins", "known_marketplaces.json"))),
      ...Object.keys(settings.extraKnownMarketplaces ?? {}),
    ]),
    plugins: new Set(Object.keys(readJsonSoft(join(CONFIG_DIR, "plugins", "installed_plugins.json")).plugins ?? {})),
  };
}

/**
 * keel migrate — restore marketplaces and plugins from a config a reset moved
 * aside.
 *
 * This exists because the reset in install.sh moves the whole config dir, and
 * the plugin registry lives inside it. Printing "here is what you lost" at the
 * end of an install is not enough: the list scrolls past, and the moment you
 * actually care is three weeks later when an install fails in another repo.
 * The old config stays under ~/.local/state/keel indefinitely, so this stays
 * runnable indefinitely.
 *
 * Restores nothing without being told to. Default is none — you asked for
 * vanilla one step earlier, and this command silently undoing that would be a
 * worse surprise than doing nothing.
 */
async function cmdMigrate(argv) {
  const flags = parseFlags(argv);
  const dry = Boolean(flags["dry-run"]);
  let mode = flags["all"] ? "all" : flags["none"] ? "none" : flags["pick"] ? "pick" : null;
  const interactive = stdin.isTTY && !flags["non-interactive"];

  console.log(`\n${c.bold("keel migrate")} — restore marketplaces and plugins from a previous setup\n`);

  const candidates = flags["from"] && flags["from"] !== "true" ? [resolve(flags["from"])] : findPreviousConfigs();
  const src = candidates.find((d) => existsSync(d));

  const have = currentState();
  const { marketplaces, plugins } = src ? readInventory(src) : { marketplaces: [], plugins: [] };
  const missingMarkets = marketplaces.filter((m) => !have.marketplaces.has(m.name));
  const missingPlugins = plugins.filter((p) => !have.plugins.has(p.id));

  /**
   * Only offer the flag repair when this run is not already going to put the
   * official marketplace back. Otherwise declining it in the list and then being
   * asked to un-suppress it are the same question twice, and answering them
   * differently would resurrect a marketplace the user just refused.
   */
  const repair = missingMarkets.some((m) => m.name === OFFICIAL_MARKETPLACE) ? null : officialFlagRepair(have);

  if (src) {
    console.log(`  ${c.dim(`from ${src}`)}`);
  } else if (repair) {
    console.log(`  ${c.dim("no previous config found — but this machine still needs one repair")}`);
  } else {
    console.log(`  ${c.dim("no previous config found — nothing to migrate")}`);
    console.log(`  ${c.dim(`looked in ${join(XDG_STATE, "keel")} and beside ${CONFIG_DIR}`)}`);
    console.log(`  ${c.dim("point at one explicitly with:  keel migrate --from DIR")}\n`);
    return 0;
  }

  if (missingMarkets.length === 0 && missingPlugins.length === 0 && !repair) {
    const had = marketplaces.length > 0 || plugins.length > 0;
    console.log(`  ${c.green("✔")} ${had ? "everything it had is already installed here" : "it had no marketplaces or plugins"} — nothing to do\n`);
    return 0;
  }

  if (src) {
    console.log(`  ${c.dim(`${marketplaces.length} marketplace(s), ${plugins.length} plugin(s); listing what is missing here`)}`);
  }
  console.log("");
  for (const m of missingMarkets) {
    const note = m.spec ? c.dim(m.spec) : c.yellow("no usable source recorded — cannot re-add automatically");
    console.log(`  ${c.bold("marketplace")}  ${m.name}  ${note}`);
    for (const p of missingPlugins.filter((p) => p.market === m.name)) {
      console.log(`       ${c.dim("plugin")}   ${p.id}${p.enabled ? "" : c.dim("  (was disabled)")}`);
    }
  }
  // Plugins whose marketplace this machine already has: restorable on their own.
  const orphans = missingPlugins.filter((p) => !missingMarkets.some((m) => m.name === p.market));
  for (const p of orphans) {
    console.log(`  ${c.bold("plugin")}       ${p.id}${p.enabled ? "" : c.dim("  (was disabled)")}`);
  }
  if (repair) {
    console.log(`  ${c.bold("repair")}       ${OFFICIAL_MARKETPLACE} is missing, and a stale flag is suppressing`);
    console.log(`               the reinstall Claude Code would otherwise do by itself`);
  }
  console.log("");

  /**
   * One readline for the whole command, opened here and closed once at the end.
   * Closing an interface ends the shared stdin stream, so a second one opened
   * afterwards resolves every question instantly with no input — which in a
   * [Y/n] loop reads as "yes" and silently restores everything the user was
   * about to decline.
   */
  const rl = interactive ? createInterface({ input: stdin, output: stdout }) : null;
  const claudeRun = (args) => {
    if (dry) {
      console.log(`    ${c.dim(`would run: claude ${args.join(" ")}`)}`);
      return true;
    }
    const r = spawnSync("claude", args, { encoding: "utf-8", timeout: 180000 });
    return r.status === 0;
  };

  let done = 0;
  let failed = 0;
  try {
    if (!mode) {
      if (!rl) {
        console.log(`  ${c.dim("non-interactive — nothing restored. Re-run with one of:")}`);
        console.log(`  ${c.dim("keel migrate --all    restore everything above")}`);
        console.log(`  ${c.dim("keel migrate --pick   choose interactively")}\n`);
        return 0;
      }
      console.log(`  ${c.bold("[a]")} all — restore everything listed`);
      console.log(`  ${c.bold("[n]")} none — stay vanilla ${c.dim("(default)")}`);
      console.log(`  ${c.bold("[p]")} pick — decide one at a time`);
      const a = (await ask1(rl, `\n  Carry over? ${c.dim("[a/N/p]")} `))?.trim().toLowerCase() ?? "";
      mode = a.startsWith("a") ? "all" : a.startsWith("p") ? "pick" : "none";
    }

    if (mode === "none") {
      console.log("");
      if (src) {
        console.log(`  ${c.dim("nothing restored — your old setup is still at")}`);
        console.log(`  ${c.dim(src)}`);
      } else {
        console.log(`  ${c.dim("nothing changed")}`);
      }
      // The repair is the one item that does not come back on its own, so the
      // manual form goes out even when the answer was no.
      if (repair) console.log(`  ${c.dim(`official marketplace still suppressed — fix with:  claude plugin marketplace add anthropics/${OFFICIAL_MARKETPLACE}`)}`);
      console.log(`  ${c.dim("change your mind any time:  keel migrate")}\n`);
      return 0;
    }

    // Without a terminal there is nobody to pick, and every prompt would take
    // its default — turning --pick into --all against the user's explicit
    // instruction to choose. Refuse instead.
    if (mode === "pick" && !rl) {
      console.log(`  ${c.yellow("!")} --pick needs a terminal to ask in.`);
      console.log(`  ${c.dim("run it interactively, or use --all to restore everything listed")}\n`);
      return 1;
    }

    // Ctrl+D mid-pick means "I am done deciding" — stop, keep what is already
    // restored, and ask nothing further. Treating it as the [Y/n] default would
    // restore the rest of the list on a keystroke that meant the opposite.
    const picking = mode === "pick" && rl;
    let aborted = false;
    const yes = async (q) => {
      if (aborted) return false;
      if (!picking) return true;
      const a = await ask1(rl, `  ${q} ${c.dim("[Y/n]")} `);
      if (a === null) {
        aborted = true;
        console.log(`  ${c.dim("stopped — nothing further restored")}`);
        return false;
      }
      return !a.trim().toLowerCase().startsWith("n");
    };

    console.log("");
    if (repair && (await yes(`clear the flag suppressing ${OFFICIAL_MARKETPLACE}?`))) {
      if (applyFlagRepair(repair, dry)) {
        done++;
        console.log(`  ${c.green("✔")} cleared ${repair.keys.join(", ")} ${c.dim("— it will reinstall itself on the next start")}`);
      } else {
        failed++;
        console.log(`  ${c.red("✖")} could not write ${repair.file} — add it by hand: claude plugin marketplace add anthropics/${OFFICIAL_MARKETPLACE}`);
      }
    }

    // Marketplaces first: `plugin install x@y` needs y to be known already.
    const restored = new Set();
    for (const m of missingMarkets) {
      if (!m.spec) continue;
      if (!(await yes(`marketplace ${m.name}?`))) continue;
      if (claudeRun(["plugin", "marketplace", "add", m.spec])) {
        restored.add(m.name);
        done++;
        console.log(`  ${c.green("✔")} ${m.name}`);
      } else {
        failed++;
        console.log(`  ${c.red("✖")} ${m.name} — add it by hand: claude plugin marketplace add ${m.spec}`);
      }
    }
    for (const p of missingPlugins) {
      // Skip a plugin whose marketplace is neither present nor just restored:
      // the install would fail, and a failure the user could not have avoided
      // reads like a bug in this command.
      if (p.market && !restored.has(p.market) && !have.marketplaces.has(p.market)) continue;
      if (!(await yes(`plugin ${p.id}?`))) continue;
      if (claudeRun(["plugin", "install", p.id, "--scope", p.scope])) {
        done++;
        // Installing enables it. Anything deliberately switched off before has
        // to be switched off again, or the restore changes how the machine runs.
        if (!p.enabled) claudeRun(["plugin", "disable", p.id]);
        console.log(`  ${c.green("✔")} ${p.id}${p.enabled ? "" : c.dim(" (disabled, as before)")}`);
      } else {
        failed++;
        console.log(`  ${c.red("✖")} ${p.id} — install it by hand: claude plugin install ${p.id}`);
      }
    }
  } finally {
    rl?.close();
  }

  console.log(`\n  ${done} restored${failed ? `, ${c.red(`${failed} failed`)}` : ""}`);
  if (done > 0 && !dry) console.log(`  ${c.dim("restart Claude Code to load them")}`);
  console.log("");
  return failed > 0 ? 1 : 0;
}

/**
 * Ctrl+D at a prompt means "stop", not "crash".
 *
 * Returns null for "the input ended", distinct from "" for a bare enter. A
 * prompt that defaults to yes has to tell those apart: enter means yes, and
 * Ctrl+D must not.
 */
async function ask1(rl, prompt) {
  try {
    return await rl.question(prompt);
  } catch {
    return null;
  }
}

// ── entry ───────────────────────────────────────────────────────────────────
const cmd = process.argv[2] ?? "status";
switch (cmd) {
  case "status":
    cmdStatus();
    break;
  case "setup":
    process.exit((await cmdSetup(process.argv.slice(3))) ? 1 : 0);
  case "settings":
    process.exit(await cmdSettings(process.argv.slice(3)));
  case "log":
    cmdLog(process.argv.slice(3));
    break;
  case "doctor":
    cmdDoctor();
    break;
  case "update":
    cmdUpdate();
    break;
  case "migrate":
    process.exit(await cmdMigrate(process.argv.slice(3)));
  case "link":
    process.exit(cmdLink(process.argv.slice(3)));
  default:
    console.log(`
${c.bold("keel")} — configures third-party memory backends for Claude Code

  keel status    what is wired            ${c.dim("(default)")}
  keel log       what you've been doing   ${c.dim("--days N [--json]")}
  keel setup     interactive wiring
  keel settings  recommended posture, with reasons  ${c.dim("--list to read without applying")}
  keel doctor    verify; exit 1 on problems
  keel update    pull the latest keel + bridge plugins
  keel migrate   restore marketplaces + plugins from a config a reset moved aside
                 ${c.dim("--all | --pick | --none, --from DIR, --dry-run")}
  keel link      put keel on your PATH  ${c.dim("--dir DIR (default ~/.local/bin)")}

keel owns no runtime. It configures other people's tools and gets out of the way.
`);
    process.exit(cmd === "help" || cmd === "--help" ? 0 : 1);
}
