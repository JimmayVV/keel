#!/usr/bin/env node
/**
 * keel — sets up and maintains configuration that keel did not author.
 *
 * Scope discipline: keel owns no runtime. It does not store memories, serve an
 * API, or run a daemon. Its entire job is to make somebody else's tool correctly
 * configured for Claude Code, and to keep it that way across updates.
 *
 * That means everything here is idempotent and surgical. keel writes only keys it
 * owns (the KEEL_* env block in settings.json), preserves everything else byte for
 * byte where it can, and reports rather than repairs anything ambiguous. Config
 * files belong to the user; a setup tool that clobbers them is a bug with a nice
 * interface.
 *
 * Commands:
 *   keel status     what is wired, what is missing, what is stale
 *   keel setup      interactive wiring of the enabled adapters
 *   keel doctor     verify prerequisites and configuration; exit 1 on problems
 */

import { readFileSync, writeFileSync, existsSync, mkdirSync, copyFileSync, readdirSync, readlinkSync, symlinkSync, unlinkSync } from "node:fs";
import { homedir } from "node:os";
import { join, dirname } from "node:path";
import { spawnSync } from "node:child_process";
import { createInterface } from "node:readline/promises";
import { stdin, stdout } from "node:process";

const CONFIG_DIR = process.env.CLAUDE_CONFIG_DIR?.trim() || join(homedir(), ".claude");
const SETTINGS = join(CONFIG_DIR, "settings.json");

/** Every env key keel manages. Anything outside this list is not ours to touch. */
const OWNED_KEYS = ["KEEL_MEMORY_HOME", "KEEL_HINDSIGHT_URL"];

const c = {
  dim: (s) => `\x1b[2m${s}\x1b[0m`,
  bold: (s) => `\x1b[1m${s}\x1b[0m`,
  green: (s) => `\x1b[32m${s}\x1b[0m`,
  yellow: (s) => `\x1b[33m${s}\x1b[0m`,
  red: (s) => `\x1b[31m${s}\x1b[0m`,
};

/**
 * Whether an adapter's bridge plugin is actually installed and enabled, via the
 * documented `claude plugin list --json` surface. An adapter can be fully
 * configured in settings.json and still unreachable — the env var is read by a
 * plugin-provided MCP server, and if that plugin isn't enabled the adapter
 * silently does nothing. Returns null for "unknown" (no claude CLI, bad
 * output); callers must not report unknown as a problem.
 */
let PLUGIN_LIST;
function pluginState(name) {
  if (PLUGIN_LIST === undefined) {
    try {
      const r = spawnSync("claude", ["plugin", "list", "--json"], { encoding: "utf-8", timeout: 15000 });
      PLUGIN_LIST = r.status === 0 ? JSON.parse(r.stdout) : null;
    } catch {
      PLUGIN_LIST = null;
    }
  }
  if (!Array.isArray(PLUGIN_LIST)) return null;
  const hit = PLUGIN_LIST.find((p) => String(p.id ?? "").split("@")[0] === name);
  return { installed: Boolean(hit), enabled: Boolean(hit?.enabled) };
}

function readSettings() {
  if (!existsSync(SETTINGS)) return {};
  try {
    return JSON.parse(readFileSync(SETTINGS, "utf-8"));
  } catch (e) {
    console.error(c.red(`✖ ${SETTINGS} is not valid JSON — refusing to touch it.`));
    console.error(`  ${e.message}`);
    process.exit(1);
  }
}

/**
 * Merge owned keys into settings.env, preserving everything else. Backs the file
 * up once per run before the first write: this is the user's config, and keel is
 * a guest in it.
 */
function writeOwnedEnv(patch) {
  const settings = readSettings();
  const before = JSON.stringify(settings);

  settings.env = { ...(settings.env ?? {}) };
  for (const [k, v] of Object.entries(patch)) {
    if (!OWNED_KEYS.includes(k)) throw new Error(`keel does not own the key ${k}`);
    if (v === null) delete settings.env[k];
    else settings.env[k] = v;
  }

  if (JSON.stringify(settings) === before) return false;

  if (existsSync(SETTINGS)) {
    const backup = `${SETTINGS}.keel-backup`;
    copyFileSync(SETTINGS, backup);
  }
  mkdirSync(dirname(SETTINGS), { recursive: true });
  writeFileSync(SETTINGS, JSON.stringify(settings, null, 2) + "\n");
  return true;
}

/**
 * Is `cmd` on PATH? Passing an args array together with shell:true concatenates
 * without escaping (Node DEP0190), so each platform gets a real argv instead.
 */
function have(cmd) {
  const safe = /^[A-Za-z0-9._-]+$/.test(cmd);
  if (!safe) return false;
  const r =
    process.platform === "win32"
      ? spawnSync("where", [cmd], { encoding: "utf-8" })
      : spawnSync("/bin/sh", ["-c", `command -v ${cmd}`], { encoding: "utf-8" });
  return (r.status ?? 1) === 0;
}

// ── what you get for free ───────────────────────────────────────────────────
// Stated explicitly because the most common setup mistake is assuming you must
// configure something. You don't. Everything here works the moment the plugin
// is installed, with no dependencies, no accounts, and no data leaving the box.
const INCLUDED = [
  ["ingest boundary", "web + MCP results marked as data, never instructions"],
  ["commit hygiene", "blocks attribution trailers you don't want in history"],
  ["activity log", "records what you asked and concluded, tagged by repo + branch"],
];

// ── adapters ────────────────────────────────────────────────────────────────
// Optional, and genuinely optional — not "optional but you'll want it".
// Each declares what it costs you, because a dependency you didn't understand
// is the thing you resent later. `egress` is called out separately from
// `prereq`: the question "does my text leave this machine" deserves its own
// line rather than being buried in a requirements list.

const ADAPTERS = {
  memory: {
    plugin: "keel-memory",
    title: "Durable notes (Basic Memory)",
    blurb: "Markdown notes on disk, searchable by Claude. No server, no account.",
    available: true,
    cost: "uv + Python 3.12 (uv provisions the interpreter for you)",
    egress: "none — local files and a local index",
    envKey: "KEEL_MEMORY_HOME",
    flag: "memory-home",
    prompt: "Where should notes live?",
    // Hidden by default: tool state does not belong as a visible directory in
    // the user's home. Anyone who wants it visible can say so at the prompt.
    defaultValue: () => join(homedir(), ".keel", "basic-memory"),
    prereq: () => ({
      ok: have("uvx"),
      what: "uvx (from uv)",
      fix: "curl -LsSf https://astral.sh/uv/install.sh | sh",
    }),
    validate: (v) => (v?.startsWith("/") || v?.startsWith("~") ? null : "must be an absolute path"),
    // Setup creates the directory, but nothing guarantees it is still there on
    // doctor day — a synced settings.json arrives on machines that never ran
    // setup, and users move directories.
    verify: (v) =>
      existsSync(v.replace(/^~/, homedir()))
        ? null
        : `notes directory does not exist: ${v}\n      fix: mkdir -p '${v}'`,
    postSetup: (v) => {
      mkdirSync(v.replace(/^~/, homedir()), { recursive: true });
      return `notes directory ready at ${v}`;
    },
  },
  reflect: {
    plugin: "keel-reflect",
    title: "Reflection (Hindsight)",
    blurb: "Memory that revises its own conclusions over time, in the background.",
    available: false,
    reason:
      "not shipped in v0.1 — the adapter was cut rather than released untested.\n" +
      "        You almost certainly do not need it: everything keel does for weekly\n" +
      "        summaries and priorities runs in-session on your existing subscription.\n" +
      "        Reflection only matters if you want derivation while you are away.",
    cost: "a self-hosted container, plus an inference provider of your choosing",
    egress:
      "NOT zero by default — extraction calls a model. Local (Ollama/LM Studio)\n" +
      "      is the only genuinely zero-egress configuration.",
    envKey: "KEEL_HINDSIGHT_URL",
    flag: "hindsight-url",
    prompt: "Hindsight base URL?",
    defaultValue: () => "http://localhost:8888",
    prereq: () => ({ ok: false, what: "the keel-reflect adapter (not in v0.1)", fix: "see docs/ROADMAP.md" }),
    validate: (v) => (/^https?:\/\//.test(v ?? "") ? null : "must be an http(s) URL"),
    postSetup: () => null,
  },
};

// ── commands ────────────────────────────────────────────────────────────────

function activityDir() {
  return process.env.KEEL_ACTIVITY_DIR?.trim() || join(CONFIG_DIR, "keel", "activity");
}

/** Every activity record, newest first. Cheap: these files are small and monthly. */
const ACTIVITY_KINDS = new Set(["ask", "said", "end"]);
function readActivity() {
  const dir = activityDir();
  if (!existsSync(dir)) return [];
  const rows = [];
  for (const f of readdirSync(dir).filter((x) => x.endsWith(".jsonl"))) {
    for (const line of readFileSync(join(dir, f), "utf-8").split("\n")) {
      if (!line.trim()) continue;
      // The security guard logs into this directory too; select by kind
      // rather than assuming every .jsonl here is activity.
      try {
        const r = JSON.parse(line);
        if (ACTIVITY_KINDS.has(r.kind)) rows.push(r);
      } catch { /* skip a torn line */ }
    }
  }
  return rows.sort((a, b) => String(b.ts).localeCompare(String(a.ts)));
}

function cmdStatus() {
  const env = readSettings().env ?? {};
  const acts = readActivity();
  console.log(`\n${c.bold("keel")}  ${c.dim(CONFIG_DIR)}`);

  // The free tier first, and unconditionally — so nobody concludes keel needs
  // configuring before it does anything.
  console.log(`\n  ${c.bold("Working now")} ${c.dim("— no setup, no dependencies, nothing leaves this machine")}`);
  for (const [name, what] of INCLUDED) {
    console.log(`    ${c.green("✔")} ${name.padEnd(20)} ${c.dim(what)}`);
  }
  console.log(
    `    ${acts.length ? c.green("✔") : c.dim("·")} ${"records captured".padEnd(20)} ` +
      c.dim(acts.length ? `${acts.length} in ${activityDir().replace(homedir(), "~")}` : "none yet — run a session"),
  );

  console.log(`\n  ${c.bold("Optional")} ${c.dim("— genuinely optional; skip all of it and keel still works")}`);
  for (const [, a] of Object.entries(ADAPTERS)) {
    const val = env[a.envKey];
    const pre = a.prereq();
    const mark = !a.available ? c.dim("—") : val ? (pre.ok ? c.green("●") : c.yellow("●")) : c.dim("○");
    const state = !a.available
      ? c.dim("not in v0.1")
      : val
        ? c.dim(val)
        : c.dim("not configured");
    console.log(`    ${mark} ${a.title.padEnd(32)} ${state}`);
    if (a.cost) console.log(`        ${c.dim(`costs:  ${a.cost}`)}`);
    if (a.egress) console.log(`        ${c.dim(`egress: ${a.egress}`)}`);
    if (!a.available && a.reason) console.log(`        ${c.dim(a.reason)}`);
    if (a.available && val && !pre.ok) console.log(`        ${c.yellow(`missing ${pre.what}`)} → ${pre.fix}`);
  }

  console.log(`\n  ${c.dim("keel log      what you've been doing")}`);
  console.log(`  ${c.dim("keel setup    wire an optional adapter")}`);
  console.log(`  ${c.dim("keel doctor   verify everything")}`);
  console.log(`  ${c.dim("keel update   pull the latest keel")}\n`);
}

/** Recent activity, grouped by day then project. Raw material for a summary. */
function cmdLog(argv) {
  const flags = parseFlags(argv);
  const days = Number(flags.days ?? 7) || 7;
  const cutoff = new Date(Date.now() - days * 86400_000).toISOString();
  const all = readActivity().filter((r) => String(r.ts) >= cutoff);
  const rows = all.filter((r) => r.kind === "ask");

  // --json is what the `week` skill consumes. Emitting the repo roster alongside
  // the records saves the skill from guessing which checkouts to run git in.
  if (flags.json) {
    const repos = {};
    for (const r of all) {
      if (!r.repo) continue;
      const e = (repos[r.repo] ??= { repo: r.repo, cwds: new Set(), branches: new Set(), prompts: 0 });
      if (r.cwd) e.cwds.add(r.cwd);
      if (r.branch) e.branches.add(r.branch);
      if (r.kind === "ask") e.prompts++;
    }
    console.log(JSON.stringify({
      since: cutoff,
      days,
      counts: { asks: rows.length, records: all.length },
      repos: Object.values(repos).map((e) => ({
        repo: e.repo,
        checkouts: [...e.cwds],
        branches: [...e.branches],
        prompts: e.prompts,
      })),
      records: all.map(({ ts, kind, repo, branch, worktree, text }) => ({
        ts, kind, repo, branch, worktree,
        text: text ? String(text).slice(0, 600) : undefined,
      })),
    }, null, 2));
    return;
  }

  if (!rows.length) {
    console.log(`\n  ${c.dim(`no activity recorded in the last ${days} day(s)`)}`);
    console.log(`  ${c.dim(`log lives at ${activityDir().replace(homedir(), "~")}`)}\n`);
    return;
  }

  console.log(`\n${c.bold(`Last ${days} days`)} ${c.dim(`— ${rows.length} prompts`)}\n`);
  const byDay = new Map();
  for (const r of rows) {
    const day = String(r.ts).slice(0, 10);
    if (!byDay.has(day)) byDay.set(day, new Map());
    const proj = r.repo ?? "(no repo)";
    const list = byDay.get(day).get(proj) ?? [];
    list.push(r);
    byDay.get(day).set(proj, list);
  }
  for (const [day, projects] of byDay) {
    console.log(`  ${c.bold(day)}`);
    for (const [proj, list] of projects) {
      const branches = [...new Set(list.map((r) => r.branch).filter(Boolean))];
      console.log(`    ${proj}${branches.length ? c.dim(`  (${branches.join(", ")})`) : ""}  ${c.dim(`${list.length}`)}`);
      for (const r of list.slice(0, 4)) console.log(`      ${c.dim("·")} ${String(r.text).slice(0, 92)}`);
      if (list.length > 4) console.log(`      ${c.dim(`… ${list.length - 4} more`)}`);
    }
    console.log();
  }
  console.log(`  ${c.dim('ask Claude "what did I do last week?" to turn this into a summary')}\n`);
}

/**
 * Flags win, then existing config, then an interactive prompt — and prompting
 * only happens on a TTY. A setup tool that can only be driven by a human cannot
 * be scripted, put in CI, or tested, which defeats the point of calling it
 * automation. Non-interactive with missing values fails loudly instead of
 * hanging on a read that will never be answered.
 */
function parseFlags(argv) {
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith("--")) continue;
    const [k, inline] = a.slice(2).split("=");
    flags[k] = inline ?? (argv[i + 1] && !argv[i + 1].startsWith("--") ? argv[++i] : "true");
  }
  return flags;
}

async function cmdSetup(argv) {
  const flags = parseFlags(argv);
  const interactive = stdin.isTTY && !flags["non-interactive"];
  const rl = interactive ? createInterface({ input: stdin, output: stdout }) : null;
  let missing = 0;

  try {
    console.log(`\n${c.bold("keel setup")} — configures adapters. Nothing is installed silently.\n`);

    for (const [name, a] of Object.entries(ADAPTERS)) {
      const env = readSettings().env ?? {};
      const current = env[a.envKey];
      const flagValue = flags[a.flag];
      const skipped = flags["skip"]?.split(",").includes(name);

      console.log(`${c.bold(a.title)}\n  ${c.dim(a.blurb)}`);

      if (skipped) {
        console.log(c.dim("  skipped (--skip)\n"));
        continue;
      }

      const pre = a.prereq();
      if (!pre.ok) {
        console.log(`  ${c.yellow(`⚠ ${pre.what} not found`)} — install it, then re-run:\n     ${pre.fix}`);
      }

      let value = flagValue ?? current;

      if (!value) {
        if (!interactive) {
          console.log(`  ${c.dim(`not configured — pass --${a.flag} <value> to wire it`)}\n`);
          missing++;
          continue;
        }
        const want = (await rl.question(`  Configure it? [y/N] `)).trim().toLowerCase();
        if (want !== "y" && want !== "yes") {
          console.log(c.dim("  skipped\n"));
          continue;
        }
        const def = a.defaultValue();
        value = (await rl.question(`  ${a.prompt} ${c.dim(`[${def}]`)} `)).trim() || def;
      }

      const bad = a.validate(value);
      if (bad) {
        console.log(`  ${c.red(`✖ ${bad}`)} — not written\n`);
        missing++;
        continue;
      }

      const changed = writeOwnedEnv({ [a.envKey]: value });
      const note = a.postSetup(value);
      console.log(`  ${c.green("✔")} ${changed ? "written to settings.json" : "already set"}${note ? ` · ${note}` : ""}`);
      // The hint has to match reality: `enable` only works on a plugin that is
      // already installed, and a fresh machine has not installed it yet.
      const ps = pluginState(a.plugin);
      if (ps?.enabled) {
        console.log(`  ${c.dim(`${a.plugin} plugin already enabled`)}\n`);
      } else if (ps?.installed) {
        console.log(`  ${c.dim(`enable the bridge: claude plugin enable ${a.plugin}@keel`)}\n`);
      } else {
        console.log(`  ${c.dim(`install the bridge: claude plugin install ${a.plugin}@keel`)}\n`);
      }
    }

    console.log(`Done. ${c.dim("Restart Claude Code (or /reload-plugins) to pick up MCP changes.")}\n`);
  } finally {
    rl?.close();
  }
  return missing;
}

function cmdDoctor() {
  const env = readSettings().env ?? {};
  let problems = 0;
  console.log(`\n${c.bold("keel doctor")}\n`);

  if (!existsSync(SETTINGS)) {
    console.log(`  ${c.yellow("○")} no settings.json at ${SETTINGS} — run \`keel setup\``);
    problems++;
  }

  for (const [, a] of Object.entries(ADAPTERS)) {
    const val = env[a.envKey];
    if (!val) {
      console.log(`  ${c.dim("○")} ${a.title} — not configured ${c.dim("(fine if unused)")}`);
      continue;
    }
    const bad = a.validate(val);
    const pre = a.prereq();
    if (bad) {
      console.log(`  ${c.red("✖")} ${a.title} — ${bad}: ${val}`);
      problems++;
      continue;
    }
    if (!pre.ok) {
      console.log(`  ${c.red("✖")} ${a.title} — missing ${pre.what}\n      fix: ${pre.fix}`);
      problems++;
      continue;
    }
    const drift = a.verify?.(val);
    if (drift) {
      console.log(`  ${c.red("✖")} ${a.title} — ${drift}`);
      problems++;
      continue;
    }
    // Configured and prerequisites present — but the env var only matters if
    // the bridge plugin that reads it is installed and enabled.
    const ps = a.plugin ? pluginState(a.plugin) : null;
    if (ps && !ps.installed) {
      console.log(`  ${c.red("✖")} ${a.title} — configured, but the ${a.plugin} plugin is not installed\n      fix: claude plugin install ${a.plugin}@keel`);
      problems++;
    } else if (ps && !ps.enabled) {
      console.log(`  ${c.red("✖")} ${a.title} — configured, but the ${a.plugin} plugin is disabled\n      fix: claude plugin enable ${a.plugin}@keel`);
      problems++;
    } else {
      const note = ps ? "" : c.dim("  (plugin state unknown — claude CLI unreachable)");
      console.log(`  ${c.green("✔")} ${a.title} ${c.dim(val)}${note}`);
    }
  }

  console.log(problems ? `\n${c.red(`${problems} problem(s)`)}\n` : `\n${c.green("all good")}\n`);
  process.exit(problems ? 1 : 0);
}

/**
 * The update slice of install.sh, without the ceremony — no backup, no reset,
 * no adapter prompts. Refresh the marketplace, update keel, update whichever
 * bridge plugins are actually installed, and repair the PATH symlink if a
 * version bump moved the cache directory out from under it.
 */
function cmdUpdate() {
  const claude = (args) => {
    const r = spawnSync("claude", args, { encoding: "utf-8", timeout: 120000 });
    return { ok: r.status === 0, out: (r.stdout || r.stderr || "").trim() };
  };
  console.log(`\n${c.bold("keel update")}\n`);
  if (spawnSync("claude", ["--version"], { encoding: "utf-8" }).status !== 0) {
    console.log(`  ${c.red("✖")} claude CLI not reachable — nothing updated\n`);
    process.exit(1);
  }
  let problems = 0;
  const step = (label, args) => {
    const r = claude(args);
    console.log(`  ${r.ok ? c.green("✔") : c.red("✖")} ${label}${r.ok ? "" : `\n      ${c.dim(r.out.split("\n")[0] ?? "")}`}`);
    if (!r.ok) problems++;
    return r.ok;
  };
  step("marketplace refreshed", ["plugin", "marketplace", "update"]);
  step("keel updated", ["plugin", "update", "keel@keel"]);
  PLUGIN_LIST = undefined; // marketplace refresh may have changed the roster
  for (const extra of ["keel-memory", "keel-reflect"]) {
    const ps = pluginState(extra);
    if (ps?.installed) step(`${extra} updated`, ["plugin", "update", `${extra}@keel`]);
  }

  // A version bump moves the cache path (…/keel/<version>/bin/keel) and leaves
  // an opted-in ~/.local/bin/keel symlink dangling. Repair only what is
  // provably ours: a symlink, dangling, pointing into the plugin cache.
  const link = join(homedir(), ".local", "bin", "keel");
  try {
    const target = readlinkSync(link);
    if (!existsSync(target) && target.includes(join("plugins", "cache", "keel"))) {
      const binDirs = readdirSync(join(CONFIG_DIR, "plugins", "cache", "keel", "keel"), { withFileTypes: true })
        .filter((d) => d.isDirectory()).map((d) => d.name).sort();
      const fresh = binDirs.length
        ? join(CONFIG_DIR, "plugins", "cache", "keel", "keel", binDirs[binDirs.length - 1], "bin", "keel")
        : null;
      if (fresh && existsSync(fresh)) {
        unlinkSync(link);
        symlinkSync(fresh, link);
        console.log(`  ${c.green("✔")} PATH link repaired ${c.dim(`${link} -> ${fresh}`)}`);
      } else {
        console.log(`  ${c.yellow("!")} ${link} is dangling and no cache copy was found — re-run install.sh`);
        problems++;
      }
    }
  } catch { /* no symlink — nothing opted in, nothing to repair */ }

  console.log(problems
    ? `\n${c.red(`${problems} problem(s)`)} — install.sh remains the full-ceremony fallback\n`
    : `\n${c.green("up to date")} ${c.dim("— new sessions pick this up; running sessions keep their startup state")}\n`);
  process.exit(problems ? 1 : 0);
}

// ── entry ───────────────────────────────────────────────────────────────────
const cmd = process.argv[2] ?? "status";
switch (cmd) {
  case "status":
    cmdStatus();
    break;
  case "setup":
    process.exit((await cmdSetup(process.argv.slice(3))) ? 1 : 0);
  case "log":
    cmdLog(process.argv.slice(3));
    break;
  case "doctor":
    cmdDoctor();
    break;
  case "update":
    cmdUpdate();
    break;
  default:
    console.log(`
${c.bold("keel")} — configures third-party memory backends for Claude Code

  keel status    what is wired            ${c.dim("(default)")}
  keel log       what you've been doing   ${c.dim("--days N [--json]")}
  keel setup     interactive wiring
  keel doctor    verify; exit 1 on problems
  keel update    pull the latest keel + bridge plugins

keel owns no runtime. It configures other people's tools and gets out of the way.
`);
    process.exit(cmd === "help" || cmd === "--help" ? 0 : 1);
}
