---
// The brandmark — the favicon's drawing, unboxed: a hull line in ink, the
// waterline beneath it, and the keel fin ending in its bulb, in bronze.
const { size = 22 } = Astro.props;
---
<svg
  class="mark"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path d="M3 9 C9 18, 23 18, 29 9" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" />
  <path d="M2 21 H30" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2" opacity="0.45" />
  <path d="M14.5 15.5 L 15 26 H 17 L 17.5 15.5 Z" fill="var(--accent)" />
  <ellipse cx="16" cy="27" rx="4.5" ry="2" fill="var(--accent)" />
</svg>
