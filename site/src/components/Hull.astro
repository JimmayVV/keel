---
// Hero illustration — the argument of the product, drawn as a shipwright would
// draw it: a lines plan. Station lines and a waterline rule the sheet; the hull
// is a single ink outline (it is not the boat); the fin keel and its ballast
// bulb are the one solid, filled shape — the thing that was laid first.
// No rig: the keel is the subject.
---
<svg
  class="hull-art"
  viewBox="0 0 520 300"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="A racing hull drawn faintly, its fin keel and ballast bulb highlighted beneath the waterline"
>
  <!-- station lines: the drawing's frame numbers, faint -->
  <g class="stations" stroke="currentColor" stroke-width="1" stroke-dasharray="2 6">
    <line x1="100" y1="40" x2="100" y2="280" />
    <line x1="170" y1="40" x2="170" y2="280" />
    <line x1="240" y1="40" x2="240" y2="280" />
    <line x1="310" y1="40" x2="310" y2="280" />
    <line x1="380" y1="40" x2="380" y2="280" />
    <line x1="450" y1="40" x2="450" y2="280" />
  </g>

  <!-- the waterline, ruled straight across the sheet -->
  <g class="water" stroke="currentColor" stroke-width="1.25" stroke-linecap="round">
    <line x1="8" y1="112" x2="512" y2="112" stroke-dasharray="10 7" />
    <line x1="8" y1="118" x2="512" y2="118" stroke-dasharray="2 9" opacity="0.5" />
  </g>

  <!-- hull: long, low, bow left — mostly above the water it barely disturbs -->
  <g class="boat" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
    <path d="M34 88
             C 130 80, 340 78, 444 90
             C 448 98, 448 104, 444 112
             C 356 138, 250 148, 190 144
             C 130 140, 70 118, 34 88 Z" />
    <!-- sheer accent -->
    <path d="M54 92 C 150 85, 330 83, 430 93" stroke-width="1" opacity="0.5" />
    <!-- rudder: thin blade dropping from the underbody, aft -->
    <path d="M392 130 C 394 156, 396 172, 402 184 C 408 172, 406 152, 402 128" stroke-width="1.5" />
  </g>

  <!-- the keel: thin blade, slight aft rake, ballast bulb. The subject. -->
  <g class="keel">
    <path d="M232 143 L 240 236 L 254 236 L 250 145 Z" fill="var(--accent)" />
    <path d="M204 244
             C 204 236, 220 231, 246 231
             C 274 231, 290 236, 290 244
             C 290 252, 274 257, 246 257
             C 220 257, 204 252, 204 244 Z"
          fill="var(--accent)" />
  </g>

  <!-- the measured part: a dimension line under the ballast -->
  <g class="dim" stroke="var(--accent)" stroke-width="1" stroke-linecap="round">
    <line x1="204" y1="274" x2="290" y2="274" />
    <line x1="204" y1="269" x2="204" y2="279" />
    <line x1="290" y1="269" x2="290" y2="279" />
  </g>
</svg>

<style>
  .hull-art { width: 100%; max-width: min(30rem, 100%); height: auto; display: block; }
  .hull-art .stations { color: var(--fg); opacity: 0.16; }
  .hull-art .water { color: var(--dim); opacity: 0.85; }
  .hull-art .boat { color: var(--fg); opacity: 0.8; }
  .hull-art .dim { opacity: 0.7; }
</style>
