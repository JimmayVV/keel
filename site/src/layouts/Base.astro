---
import "../styles/global.css";
const { title = "keel — a curated layer under Claude Code", description = "A keel is the beam a hull is built on. This one goes under Claude Code: guards at the ingest boundary, commit hygiene, an activity log, and wiring for a memory backend your machines can share." } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const current = (p) => (path === p ? "page" : undefined);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <nav>
    <div class="wrap">
      <a class="brand" href="/"><span class="tick">▲</span> keel</a>
      <div class="links">
        <a href="/install" aria-current={current("/install")}>install</a>
        <a href="/skills" aria-current={current("/skills")}>skills</a>
        <a href="/philosophy" aria-current={current("/philosophy")}>philosophy</a>
        <a href="https://github.com/JimmayVV/keel">github ↗</a>
      </div>
    </div>
  </nav>

  <slot />

  <footer>
    <div class="wrap">
      <p>MIT licence. Hook patterns descend from Daniel Miessler's PAI (MIT), since renamed
      LifeOS — an independent implementation, not a fork; the
      <a href="https://github.com/JimmayVV/keel/blob/main/NOTICE">NOTICE</a> file scopes
      exactly what was derived.</p>
      <p class="promise">this site is static html — no javascript, no analytics, no cookies, no third-party requests.</p>
    </div>
  </footer>
</body>
</html>
